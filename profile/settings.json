{
  "theme": "PhpStorm Dark",
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/.zed",
    "**/.phpworkbench"
  ],
  "base_keymap": "JetBrains",
  "go_to_definition_fallback": "none",
  "lsp_results_location": "picker",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 16,
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 16,
  "git_commit_buffer_font_size": 15,
  "tab_size": 4,
  "hard_tabs": false,
  "preferred_line_length": 120,
  "soft_wrap": "none",
  "autosave": "on_focus_change",
  "format_on_save": "off",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "show_whitespaces": "selection",
  "relative_line_numbers": false,
  "inlay_hints": {
    "enabled": true
  },
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500
    }
  },
  "tabs": {
    "show": true,
    "show_tab_bar_buttons": true
  },
  "project_panel": {
    "dock": "left",
    "button": true,
    "default_width": 260,
    "entry_spacing": "comfortable",
    "file_icons": true
  },
  "outline_panel": {
    "dock": "left",
    "button": true,
    "default_width": 240
  },
  "git_panel": {
    "dock": "left",
    "button": true,
    "starts_open": true,
    "file_icons": true,
    "status_style": "label_color"
  },
  "debugger": {
    "dock": "bottom"
  },
  "terminal": {
    "dock": "bottom"
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "agent": {
    "dock": "right",
    "button": false
  },
  "languages": {
    "PHP": {
      "language_servers": [
        "phpantom",
        "!intelephense",
        "!phpactor",
        "!phptools"
      ],
      "format_on_save": "off"
    },
    "JSON": {
      "language_servers": [
        "json-language-server",
        "deps_guard"
      ]
    }
  },
  "lsp": {
    "phpantom": {
      "binary": {
        "path": "phpantom_lsp"
      }
    },
    "intelephense": {
      "initialization_options": {
        "storagePath": "/tmp/intelephense",
        "clearCache": false
      }
    }
  },
  "edit_predictions": {
    "provider": "none"
  },
  "features": {
    "edit_prediction": false
  },
  "title_bar": {
    "show_sign_in": false,
    "show_user_menu": false,
    "show_onboarding_banner": false,
    "show_user_picture": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "disable_ai": true
}